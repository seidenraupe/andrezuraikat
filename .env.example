# KreativMedia / Plesk — SFTP-Upload von dist/ (lokal, nicht committen).
# Kopieren nach .env und Werte aus Plesk → FTP-Zugang eintragen.

KREATIVMEDIA_SFTP_HOST=
KREATIVMEDIA_SFTP_PORT=22
KREATIVMEDIA_SFTP_USER=
KREATIVMEDIA_SFTP_PASSWORD=
# Document Root der Domain in Plesk (Dateien → andrezuraikat.ch)
KREATIVMEDIA_REMOTE_PATH=
