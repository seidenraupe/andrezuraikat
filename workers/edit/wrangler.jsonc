{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "andrezuraikat-edit",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "durable_objects": {
    "bindings": [{ "name": "EDIT", "class_name": "EditStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EditStore"] }],
  "vars": {
    "SMTP_HOST": "smtp.office365.com",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "tls",
    "SMTP_FROM": "noreply@andrezuraikat.ch",
    "SMTP_FROM_NAME": "André Zuraikat"
  }
}
