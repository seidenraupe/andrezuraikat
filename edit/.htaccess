# Interner Bearbeitungszugang /edit/ — E-Mail-Code, kein öffentliches Caching.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /edit/

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^redaktion/lib\.php$ - [F,L]
  RewriteRule ^redaktion/config\.mail\.php$ - [F,L]
  RewriteRule ^redaktion/storage/ - [F,L]
  RewriteRule ^assets/ - [L]
  RewriteRule ^js/edit-mode\.js$ - [L]
  RewriteRule ^ - zugang/serve.php [L]
</IfModule>
